{
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "prisma7.config.ts",
    "vitest.config.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "generated/**/*.ts"
  ]
}
